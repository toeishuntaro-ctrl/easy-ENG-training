rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Test connection document for initial health check
    match /test/{docId} {
      allow read: if true;
    }

    // Shared Sync Profiles (for cross-device sync via Sync Code)
    match /sync_profiles/{syncCode} {
      allow read, write: if true;

      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // Direct User documents
    match /users/{userId} {
      allow read, write: if isAuthenticated();

      match /weapons/{weaponId} {
        allow read, write: if isAuthenticated();
      }

      match /spaced_items/{itemId} {
        allow read, write: if isAuthenticated();
      }

      match /quiz_history/{quizId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}

