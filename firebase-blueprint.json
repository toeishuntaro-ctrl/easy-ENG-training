{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, XP, streak, and synced settings across PC and mobile",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "xp": { "type": "integer" },
        "streak": { "type": "integer" },
        "totalAnswered": { "type": "integer" },
        "correctCount": { "type": "integer" },
        "lastDate": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "xp", "streak"]
    },
    "SavedWeapon": {
      "title": "SavedWeapon",
      "description": "User saved Plain English key pattern or target phrase",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "target": { "type": "string" },
        "guide": { "type": "string" },
        "key_pattern": { "type": "string" },
        "key_pattern_jp": { "type": "string" },
        "topic": { "type": "string" },
        "savedAt": { "type": "string" }
      },
      "required": ["userId", "target", "guide"]
    },
    "SpacedItem": {
      "title": "SpacedItem",
      "description": "Spaced repetition item for memory retention",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "target": { "type": "string" },
        "guide": { "type": "string" },
        "ai_en": { "type": "string" },
        "level": { "type": "integer" },
        "dueDate": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "target", "dueDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document storing high-level progress"
    },
    "/users/{userId}/weapons/{weaponId}": {
      "schema": { "$ref": "#/entities/SavedWeapon" },
      "description": "User's saved Plain English weapons and favorite phrases"
    },
    "/users/{userId}/spaced_items/{itemId}": {
      "schema": { "$ref": "#/entities/SpacedItem" },
      "description": "Spaced repetition review queue"
    }
  }
}
